# LOCAL DEVELOPMENT ONLY. Copy to .env and replace values.
SECRET_KEY=replace-with-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value
DATABASE_URL=postgresql+psycopg://talentflow:local-only-password@db:5432/talentflow
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AWS_REGION=ap-south-1
S3_BUCKET=
SQS_RESUME_QUEUE_URL=
EVENT_BUS_NAME=default
AUTO_CREATE_TABLES=true
